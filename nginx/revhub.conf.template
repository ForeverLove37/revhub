# This file is included from nginx's http context by sites-enabled/revhub.conf.
# Variable-based proxy_pass values force Nginx to use the resolvers below instead
# of retaining stale upstream addresses after a provider changes an IP address.
map $upstream_http_www_authenticate $revhub_ghcr_authenticate {
    default $upstream_http_www_authenticate;
    ~*^Bearer\s+realm="https://ghcr\.io/token"(?<revhub_ghcr_auth_suffix>.*)$ "Bearer realm=\"https://ghcr.cloudengine.host/token\"$revhub_ghcr_auth_suffix";
}

map $upstream_http_www_authenticate $revhub_docker_authenticate {
    default $upstream_http_www_authenticate;
    ~*^Bearer\s+realm="https://auth\.docker\.io/token"(?<revhub_docker_auth_suffix>.*)$ "Bearer realm=\"https://docker.cloudengine.host/token\"$revhub_docker_auth_suffix";
}

map $upstream_http_www_authenticate $revhub_gcr_authenticate {
    default $upstream_http_www_authenticate;
    ~*^Bearer\s+realm="https://gcr\.io/v2/token"(?<revhub_gcr_auth_suffix>.*)$ "Bearer realm=\"https://gcr.cloudengine.host/v2/token\"$revhub_gcr_auth_suffix";
}

map $upstream_http_www_authenticate $revhub_k8s_authenticate {
    default $upstream_http_www_authenticate;
    ~*^Bearer\s+realm="https://registry\.k8s\.io/v2/token"(?<revhub_k8s_auth_suffix>.*)$ "Bearer realm=\"https://k8s.cloudengine.host/v2/token\"$revhub_k8s_auth_suffix";
}

map $upstream_http_www_authenticate $revhub_quay_authenticate {
    default $upstream_http_www_authenticate;
    ~*^Bearer\s+realm="https://quay\.io/v2/auth"(?<revhub_quay_auth_suffix>.*)$ "Bearer realm=\"https://quay.cloudengine.host/v2/auth\"$revhub_quay_auth_suffix";
}

map $host $revhub_hf_xet_base {
    default https://hf.cloudengine.host;
    hf.cloudengine.host https://hf.cloudengine.host;
    hf.erailab.com https://hf.erailab.com;
}

server {
    listen 80;
    listen [::]:80;
    server_name hf.cloudengine.host raw.cloudengine.host ghcr.cloudengine.host docker.cloudengine.host gcr.cloudengine.host k8s.cloudengine.host quay.cloudengine.host civitai.cloudengine.host kaggle.cloudengine.host goproxy.cloudengine.host hashicorp.cloudengine.host hf.erailab.com;

    location ^~ /.well-known/acme-challenge/ {
        root __ACME_WEBROOT__;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name hf.cloudengine.host;

    ssl_certificate __LETSENCRYPT_LIVE_DIR__/revhub-cloudengine/fullchain.pem;
    ssl_certificate_key __LETSENCRYPT_LIVE_DIR__/revhub-cloudengine/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:RevHubTLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_max_temp_file_size 0;
    proxy_connect_timeout 30s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
    send_timeout 3600s;

    resolver 1.1.1.1 1.0.0.1 valid=300s ipv6=off;
    resolver_timeout 5s;

    location / {
        set $revhub_hf_upstream huggingface.co;
        proxy_http_version 1.1;
        proxy_set_header Host huggingface.co;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host huggingface.co;
        proxy_set_header Connection "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Accept-Encoding "";
        proxy_pass_request_headers on;
        proxy_ssl_server_name on;
        proxy_ssl_name huggingface.co;
        proxy_redirect https://huggingface.co/ /;
        proxy_redirect http://huggingface.co/ /;
        proxy_redirect ~^https?://cas-server\.xethub\.hf\.co/(.*)$ /__hf_xet/cas-server/$1;
        proxy_redirect ~^https?://cas-bridge\.xethub\.hf\.co/(.*)$ /__hf_xet/cas-bridge/$1;
        sub_filter_once off;
        sub_filter_types application/json application/problem+json;
        sub_filter 'https://cas-server.xethub.hf.co' '$revhub_hf_xet_base/__hf_xet/cas-server';
        sub_filter 'https://cas-bridge.xethub.hf.co' '$revhub_hf_xet_base/__hf_xet/cas-bridge';
        proxy_pass https://$revhub_hf_upstream;
    }

    location ^~ /__hf_xet/cas-server {
        set $revhub_hf_xet_server cas-server.xethub.hf.co;
        rewrite ^/__hf_xet/cas-server/?(.*)$ /$1 break;
        proxy_http_version 1.1;
        proxy_set_header Host cas-server.xethub.hf.co;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name cas-server.xethub.hf.co;
        proxy_redirect ~^https?://cas-bridge\.xethub\.hf\.co/(.*)$ /__hf_xet/cas-bridge/$1;
        proxy_pass https://$revhub_hf_xet_server$uri$is_args$args;
    }

    location ^~ /__hf_xet/cas-bridge {
        set $revhub_hf_xet_bridge cas-bridge.xethub.hf.co;
        rewrite ^/__hf_xet/cas-bridge/?(.*)$ /$1 break;
        proxy_http_version 1.1;
        proxy_set_header Host cas-bridge.xethub.hf.co;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name cas-bridge.xethub.hf.co;
        proxy_redirect ~^https?://cas-server\.xethub\.hf\.co/(.*)$ /__hf_xet/cas-server/$1;
        proxy_pass https://$revhub_hf_xet_bridge$uri$is_args$args;
    }
}

